# Copy to .env and fill in local values. Never commit .env.
# Placeholder values only: no real secrets in this file.

# PostgreSQL (docker-compose.yml publishes the container on 127.0.0.1:5434)
POSTGRES_USER=mlops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mlops
DATABASE_URL=postgresql+psycopg://mlops:change-me@localhost:5434/mlops
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT=5

# Prediction API
MODEL_DIR=artifacts/<version>
LOG_LEVEL=INFO
MAX_BODY_BYTES=1048576

# Labeled performance: below this many labeled rows, metrics are "unknown"
MIN_LABELS=100



MONITOR_WINDOW_SIZE=500 #Rows in the current window
MONITOR_MIN_ROWS=300 #Below this, status is insufficient_data
DRIFT_SHARE_THRESHOLD=0.3    #Share of drifting features that raises a drift alert (you calibrate it below)
MIN_LABELS=100 #Below this, performance is unknown
MONITOR_INTERVAL_SECONDS=300 #Loop interval for the monitoring job